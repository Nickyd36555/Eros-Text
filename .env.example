# --- Server ---
PORT=3000
# Brand name used in every text message.
STORE_NAME=Eros Labs

# --- SMS provider ---
# Which service actually sends the texts: "twilio" or "telnyx".
# Only the selected provider's credentials below are required.
SMS_PROVIDER=telnyx

# --- Telnyx (used when SMS_PROVIDER=telnyx) ---
# Create an API key at https://portal.telnyx.com (API Keys section).
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Use EITHER a Messaging Profile ID (recommended) OR a single "from" number in
# E.164 format. If both are set, both are sent and Telnyx uses the profile.
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_FROM=+15555550123

# --- Twilio (used when SMS_PROVIDER=twilio) ---
# Find these at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Use EITHER a Messaging Service SID (recommended: handles STOP/opt-out + number
# pooling) OR a single "from" number in E.164 format. Messaging Service wins.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=+15555550123

# --- WooCommerce ---
# The secret you set when creating the webhook in
# WooCommerce > Settings > Advanced > Webhooks. Used to verify the signature.
WC_WEBHOOK_SECRET=your_webhook_secret

# Default country (ISO 3166-1 alpha-2) used to normalize phone numbers to E.164
# when the order's billing country is missing. Most US stores want "US".
DEFAULT_COUNTRY=US

# Which WooCommerce order status means "shipped". Default WooCommerce uses
# "completed" for this. If you use a custom status (e.g. from a shipping
# plugin), set it here WITHOUT the "wc-" prefix, e.g. "shipped".
SHIPPED_STATUS=completed

# Where the SQLite idempotency store lives (prevents duplicate texts).
DB_PATH=data/eros-text.sqlite
